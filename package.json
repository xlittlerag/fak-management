{
  "name": "kendo-manager",
  "version": "1.2.0",
  "description": "",
  "author": "",
  "packageManager": "pnpm@11.11.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src test",
    "lint:fix": "oxlint --type-aware --fix src test",
    "typecheck": "node ./node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.build.json",
    "typecheck:test": "node ./node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage --project unit",
    "test:debug": "vitest --inspectBrk --project e2e",
    "test:e2e": "vitest run --project e2e",
    "seed": "tsx prisma/seed.ts",
    "test:email": "tsx scripts/send-test-email.ts",
    "check:secrets": "node scripts/check-secrets.mjs --tracked",
    "check:secrets:staged": "node scripts/check-secrets.mjs --staged",
    "security": "pnpm audit --prod && pnpm run check:secrets",
    "preflight": "pnpm run security && pnpm run typecheck && pnpm run typecheck:test && pnpm --filter frontend run typecheck && pnpm run build",
    "prepare": "husky",
    "changelog": "sh scripts/changelog.sh"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@types/compression": "^1.8.1",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "mercadopago": "^3.6.1",
    "multer": "^2.4.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "test/**/*.ts": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "oxlint -c frontend/.oxlintrc.json --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "^12.1.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
