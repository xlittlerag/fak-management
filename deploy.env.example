# Kendo Manager — variables para compose en producción.
#   cp deploy.env.example deploy.env   # y completar cada valor
# deploy.env NUNCA se commitea (contiene secretos).
#
# Generar secretos con:
#   openssl rand -hex 64   # JWT_SECRET
#   openssl rand -hex 32   # TOTP_ENCRYPTION_KEY
#   openssl rand -base64 32  # BACKUP_PASSPHRASE

# Firma de JWT (obligatorio, mínimo 32 caracteres: sin él no arranca).
JWT_SECRET=

# Cifrado del secreto 2FA del admin (obligatorio para 2FA; sin él queda
# deshabilitado con 503).
TOTP_ENCRYPTION_KEY=

# Bootstrap del admin general DNI 00000000 (obligatorio en primer arranque,
# mínimo 15 caracteres: sin él el contenedor no arranca).
ADMIN_PASSWORD=

# Mercado Pago (obligatorio para cobros reales).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_SIMULATED=false
# Public key embebida en el frontend al construir la imagen (build-arg).
VITE_MERCADO_PAGO_PUBLIC_KEY=
# Firma de webhooks (dashboard de MP → Webhooks; obligatorio en prod).
# MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública de la app (webhooks y redirecciones de MP).
APP_URL=https://kendo.example.com

# Orígenes extra con credenciales (en prod el frontend es mismo origen;
# solo definir si el frontend corre separado, siempre https).
# CORS_ORIGIN=https://app.example.com

# Backups cifrados (obligatorio para backup.sh/restore.sh).
BACKUP_PASSPHRASE=
# BACKUP_DEST=gdrive:backups/kendo-prod
# RETENTION_DAYS=30

# Email (opcional: sin SMTP no se envían notificaciones).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Kendo Manager <noreply@kendo-manager.com.ar>"

# Nivel de log (debug|info|warn|error).
# LOG_LEVEL=info
