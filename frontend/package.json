{
  "name": "frontend",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:stats": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "typecheck": "node ../node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.app.json && node ../node_modules/typescript-native/bin/tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "e2e": "playwright test",
    "perf": "PERF=1 playwright test e2e/perf/performance.spec.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "preact": "^11.0.1",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
