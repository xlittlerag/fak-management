# Base de datos
DATABASE_URL=file:./dev.db

# JWT
JWT_SECRET=change-this-to-a-secure-random-string

# 2FA del admin general (TOTP): clave de cifrado de secretos.
# Generar con: openssl rand -hex 32. Sin esta variable el 2FA queda
# deshabilitado (los endpoints responden 503).
TOTP_ENCRYPTION_KEY=

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxx-xxxxxxxx
MERCADO_PAGO_SIMULATED=false
# Secreto de firma de webhooks (dashboard de MP → Webhooks). Sin él, el
# webhook acepta notificaciones sin verificar (solo entornos de prueba).
# MERCADO_PAGO_WEBHOOK_SECRET=

# URL de la aplicación (para webhooks y redirecciones)
APP_URL=http://localhost:3000

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Rate limit global (opcional, por defecto 30 req/min). Solo elevar en
# entornos de test E2E con mucho tráfico desde una misma IP.
# THROTTLE_LIMIT=30
# THROTTLE_TTL=60000

# Orígenes permitidos para CORS con credenciales (separados por coma).
# En producción el frontend se sirve desde el mismo origen y no hace falta.
# Para desarrollo con Vite en otro puerto, agregarlo aquí.
CORS_ORIGIN=http://localhost:5173

# Seed de datos de prueba en el contenedor (solo entornos de dev/test)
# SEED_DATABASE=false

# SMTP (notificaciones por email - opcional, sin esto no se envían emails)
# Para Gmail: activar 2FA y generar App Password en
# https://myaccount.google.com/apppasswords. Solo apto para pruebas o
# volúmenes bajos (~500/día); para producción usar un proveedor transaccional
# con dominio verificado (SPF/DKIM/DMARC). Ver docs/iteraciones/08-notificaciones.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 465 = TLS directo; 587/25 = STARTTLS. Si no se define, se infiere del puerto.
# SMTP_SECURE=false
# Exigir STARTTLS (útil en producción).
# SMTP_REQUIRE_TLS=true
SMTP_USER=su-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# En producción usar la cuenta dedicada sobre el dominio propio, por ejemplo:
# SMTP_FROM="Kendo Argentina <notificaciones@kendoargentina.org.ar>"
SMTP_FROM="Kendo Manager <noreply@kendo-manager.com.ar>"
